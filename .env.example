# Cloudinary credentials (from https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Public URL Cloudinary will POST async results to (moderation, tagging)
# Use ngrok or a deployed URL during development, e.g. https://xxxx.ngrok.io/api/webhook
#CLOUDINARY_WEBHOOK_URL=https://your-domain.com/api/webhook
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/cloudinary_ai_media

# Server port
PORT=3000

# Optional: comma-separated list of admin API keys for protected routes
ADMIN_API_KEY=changeme

# Cloudinary paid AI add-ons are off by default. Set an item to true only if
# the corresponding Cloudinary add-on is enabled for your account.
CLOUDINARY_ENABLE_TAGGING=false
CLOUDINARY_ENABLE_OBJECT_DETECTION=false
CLOUDINARY_ENABLE_MODERATION=false
